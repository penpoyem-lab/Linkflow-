# ============================================================================
# LinkFlow Environment & API Configuration (.env.example)
# ============================================================================
# All keys in this file are placeholders. Never commit real credentials or
# private tokens to Git. In Google AI Studio, configure secrets via the
# Secrets panel in the UI.
# ============================================================================

# Optional: Official YouTube Data API v3 Key (for enriched YouTube metadata,
# ISO-8601 duration, and Creative Commons license inspection).
YOUTUBE_DATA_API_KEY=YOUR_YOUTUBE_DATA_API_KEY

# Optional: Custom Backend Media Proxy Base URL (if self-hosting an authorized
# FFmpeg / media inspection API server alongside the Android app).
# Leave commented out to use LinkFlow's built-in on-device HTTP & oEmbed engine.
# LINKFLOW_BACKEND_BASE_URL=https://api.example.com

# Optional: Gemini API Key (only if AI features are added in future builds).
# GEMINI_API_KEY=MY_GEMINI_API_KEY
